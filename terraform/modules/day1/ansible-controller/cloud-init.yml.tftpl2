#cloud-config

package_update: true
package_upgrade: true

packages:
  - python3-pip
  - unzip
  - curl

####################################################################
# Create directory before write_files executes
####################################################################

bootcmd:
  - mkdir -p /home/${ansible_admin_username}/ansible

####################################################################
# Configuration Files
####################################################################

write_files:

  ####################################################################
  # Ansible Configuration
  ####################################################################

  - path: /home/${ansible_admin_username}/ansible/ansible.cfg
    permissions: "0644"
    content: |
      [defaults]
      inventory = /home/azureuser/az-platform-eng-bootcamp/day3/azure_inventory.py
      host_key_checking = False
      local_tmp = /home/${ansible_admin_username}/.ansible/tmp
      remote_tmp = /tmp/.ansible/tmp
      remote_user = ${ansible_admin_username}
      interpreter_python = auto_silent

####################################################################
# Bootstrap Commands
####################################################################

runcmd:

  ####################################################################
  # Fix ownership
  ####################################################################

  - mkdir -p /home/${ansible_admin_username}/.ansible/tmp
  - chown -R ${ansible_admin_username}:${ansible_admin_username} /home/${ansible_admin_username}
  - chmod 700 /home/${ansible_admin_username}/.ansible

  ####################################################################
  # Install Ansible and Azure SDK for Ansible
  ####################################################################

  - python3 -m pip install --break-system-packages ansible
  - python3 -m pip install --break-system-packages azure-identity azure-mgmt-resource azure-mgmt-compute azure-mgmt-network msrestazure

  ####################################################################
  # Install Azure CLI
  ####################################################################

  - curl -sL https://aka.ms/InstallAzureCLIDeb | bash

  ####################################################################
  # Login using Managed Identity (verification only)
  ####################################################################

  - az login --identity

  ####################################################################
  # Verify Installation
  ####################################################################

  - ansible --version
  - az account show

final_message: "Ansible Controller bootstrap completed successfully."




